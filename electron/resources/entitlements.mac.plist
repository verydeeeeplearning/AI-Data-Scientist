<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- P0-05: Hardened runtime entitlements for notarization.
         The PyInstaller-built backend is spawned as a child process and
         dynamically loads its own interpreter, which requires these two
         exceptions. Without them notarytool accepts the bundle but it
         crashes on first launch with a code-signing violation. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Agent reads user-chosen workspace dirs and writes artifacts there. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Required for outbound HTTPS to LLM providers and update server. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
