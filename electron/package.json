{
  "name": "ds-agent-desktop",
  "version": "0.1.0",
  "description": "DS Agent — AI Data Scientist Desktop App",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron dist/main/index.js",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win",
    "dist:mac": "npm run build && electron-builder --config electron-builder.yml --mac",
    "dist:linux": "npm run build && electron-builder --config electron-builder.yml --linux",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.json",
    "lint:arch": "node scripts/lint-arch.mjs",
    "lint:a11y": "node scripts/lint-a11y.mjs",
    "lint:i18n": "i18next-parser --config i18next-parser.config.cjs --silent",
    "lint:i18n:ci": "node scripts/lint-i18n.mjs",
    "test:contract:i18n-namespaces": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/i18nNamespaces.spec.js",
    "test:contract:i18n-store-shim": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/i18nStoreShim.spec.js",
    "test:contract:eslint-arch-rule": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/eslintArchRule.spec.js",
    "test:contract:ws-envelope": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/wsEnvelope.spec.js",
    "test:contract:event-schema-registry": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/eventSchemaRegistry.spec.js",
    "test:contract:focus-management": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/focusManagement.spec.js",
    "test:contract:reduced-motion": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/reducedMotion.spec.js",
    "test:contract:wave0": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/eslintArchRule.spec.js && node tests/.compiled-contract/tests/contract/wsEnvelope.spec.js && node tests/.compiled-contract/tests/contract/eventSchemaRegistry.spec.js && node tests/.compiled-contract/tests/contract/focusManagement.spec.js && node tests/.compiled-contract/tests/contract/reducedMotion.spec.js",
    "test:contract:delivery-preview": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/task-contract-preview.spec.js",
    "test:contract:mission-brief": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/mission-brief.spec.js",
    "test:contract:policy-studio": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/policy-studio.spec.js",
    "test:contract:work-objects": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/work-object-panel.spec.js",
    "test:contract:verifier": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/verifier-quality-panel.spec.js",
    "test:contract:runtime": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/regression-board.spec.js",
    "test:contract:semantic-metric-panel": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/semantic-metric-panel.spec.js",
    "test:contract:project-control-tower": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/project-control-tower.spec.js",
    "test:contract:learning-inbox": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/learning-inbox.spec.js",
    "test:contract:suggested-actions-wiring": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/suggestedActionsWiring.spec.js",
    "test:contract:global-drop-overlay": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/globalDropOverlay.spec.js",
    "test:contract:upload-error-states": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/uploadErrorStates.spec.js",
    "test:contract:upload-ui": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/suggestedActionsWiring.spec.js && node tests/.compiled-contract/tests/contract/globalDropOverlay.spec.js && node tests/.compiled-contract/tests/contract/uploadErrorStates.spec.js",
    "test:contract:execution-timeline-stages": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/executionTimelineStages.spec.js",
    "test:contract:execution-timeline-feature-flag": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/executionTimelineFeatureFlag.spec.js",
    "test:contract:use-execution-timeline": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/useExecutionTimeline.spec.js",
    "test:contract:stage-outcome-link": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/stageOutcomeLink.spec.js",
    "test:contract:execution-timeline-a11y": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/executionTimelineA11y.spec.js",
    "test:contract:execution-timeline": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/executionTimelineStages.spec.js && node tests/.compiled-contract/tests/contract/executionTimelineFeatureFlag.spec.js && node tests/.compiled-contract/tests/contract/useExecutionTimeline.spec.js && node tests/.compiled-contract/tests/contract/stageOutcomeLink.spec.js && node tests/.compiled-contract/tests/contract/executionTimelineA11y.spec.js",
    "test:contract:mission-context": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/missionContext.spec.js",
    "test:contract:mission-header-flag": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/missionHeaderFlag.spec.js",
    "test:contract:mission-header-integration": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/missionHeaderIntegration.spec.js",
    "test:contract:mission-header-shortcut": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/missionHeaderShortcut.spec.js",
    "test:contract:ws-mission-resubscribe": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/wsMissionResubscribe.spec.js",
    "test:contract:mission-header": "tsc -p tsconfig.contract-test.json && node tests/.compiled-contract/tests/contract/missionContext.spec.js && node tests/.compiled-contract/tests/contract/missionHeaderFlag.spec.js && node tests/.compiled-contract/tests/contract/missionHeaderIntegration.spec.js && node tests/.compiled-contract/tests/contract/missionHeaderShortcut.spec.js && node tests/.compiled-contract/tests/contract/wsMissionResubscribe.spec.js",
    "test:e2e:smoke": "npm run build && tsc -p tsconfig.test.json && node tests/.compiled/smoke/diagnostic-window.spec.js",
    "test:e2e:happy": "npm run build && tsc -p tsconfig.test.json && node tests/.compiled/smoke/happy-path.spec.js",
    "test:e2e:autonomy": "npm run build && tsc -p tsconfig.test.json && node tests/.compiled/smoke/autonomy-control-plane.spec.js",
    "test:e2e:task-contract": "npm run build && tsc -p tsconfig.test.json && node tests/.compiled/smoke/task-contract-assumptions.spec.js && node tests/.compiled/smoke/task-contract-lifecycle.spec.js && node tests/.compiled/smoke/task-contract-governance.spec.js",
    "test:e2e:decision-os": "npm run build && tsc -p tsconfig.test.json && node tests/.compiled/smoke/decision-os-review.spec.js",
    "test:e2e:workflow": "npm run build && tsc -p tsconfig.test.json && node tests/.compiled/smoke/workflow-integration.spec.js",
    "test:e2e:a11y": "npm run build && tsc -p tsconfig.test.json && node tests/.compiled/e2e/a11y/onboarding.a11y.spec.js && node tests/.compiled/e2e/a11y/mission.a11y.spec.js && node tests/.compiled/e2e/a11y/chat.a11y.spec.js && node tests/.compiled/e2e/a11y/settings.a11y.spec.js && node tests/.compiled/e2e/a11y/sidebar.a11y.spec.js"
  },
  "dependencies": {
    "@sentry/electron": "^7.11.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "i18next": "^23.16.8",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^31.7.5",
    "electron-builder": "^24.13.3",
    "i18next-parser": "^9.4.0",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "author": "DS Agent",
  "license": "MIT"
}
